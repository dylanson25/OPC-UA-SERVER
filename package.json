  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "3.9.6",
    "rimraf": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.17.0",
    "vitest": "^4.1.10"
  }
